# BrewBack Environment Configuration
# Copy this file to .env and modify values as needed

# Database Configuration
# Path to SQLite database file
DB_PATH=./brewback.db

# Connection Pool Settings
DB_POOL_SIZE=5
DB_POOL_GET_TIMEOUT=3000
DB_POOL_RETRY_INTERVAL=50

# API Security
# API key for batch data submissions (e.g., from Brewfather)
BATCH_DATA_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=production
