{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["es2020"],
        "rootDir": "src",
        "outDir": "dist",
        "moduleResolution": "node",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}